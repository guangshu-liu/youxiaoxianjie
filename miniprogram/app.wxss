/* app.wxss — 全局样式，移植自网页版 src/css/base.css + game.css
 *
 * 保留原来的 6 岁儿童 UI 规范：按钮 ≥60px、字号 ≥22px、高对比、点按有反馈。
 * 尺寸沿用 px 而不是 rpx —— 这套设计是按 375pt 的手机排的，两端口径一致，
 * 改一处不用换算两次。
 */

page {
  --c-bg:        #FFF8E7;
  --c-bg-alt:    #FFFFFF;
  --c-ink:       #2D3142;
  --c-ink-soft:  #6B7280;
  --c-primary:   #FF8A65;
  --c-primary-d: #F4703F;
  --c-second:    #4FC3F7;
  --c-ok:        #66BB6A;
  --c-bad:       #EF5350;
  --c-warn:      #FFB74D;
  --c-line:      #E8E0D0;

  --r-sm: 10px;
  --r-md: 16px;
  --r-lg: 24px;
  --r-xl: 32px;

  --tap: 60px;
  --gap: 14px;

  --shadow: 0 4px 0 rgba(0,0,0,.10), 0 8px 24px rgba(0,0,0,.06);

  background: var(--c-bg);
  color: var(--c-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
               "Microsoft YaHei", "Helvetica Neue", sans-serif;
  font-size: 20px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

/* ---------- 屏幕容器 ---------- */

.screen {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 18px 18px calc(18px + env(safe-area-inset-bottom));
  animation: screen-in .26s ease-out;
}

@keyframes screen-in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: none; }
}

/* ---------- 按钮 ---------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap);
  min-width: var(--tap);
  padding: 14px 24px;
  margin: 0;
  font-size: 22px;
  font-weight: 700;
  line-height: 1.25;
  color: var(--c-ink);
  background: var(--c-bg-alt);
  border: none;
  border-radius: var(--r-md);
  box-shadow: var(--shadow);
}

/* 小程序 button 默认带一条 ::after 边框，不去掉会像描边错位 */
.btn::after { border: none; }

.btn-primary {
  background: linear-gradient(180deg, #FFA07A 0%, var(--c-primary) 100%);
  color: #fff;
  text-shadow: 0 1px 2px rgba(0,0,0,.18);
}

.btn-secondary { background: linear-gradient(180deg, #7FD8FF 0%, var(--c-second) 100%); color: #fff; }
.btn-ghost     { background: transparent; box-shadow: none; color: var(--c-ink-soft); border: 2px solid var(--c-line); }
.btn-danger    { background: var(--c-bad); color: #fff; }

.btn-xl  { font-size: 28px; min-height: 78px; border-radius: var(--r-lg); width: 100%; }
.btn-sm  { font-size: 17px; min-height: 44px; padding: 8px 16px; }
.btn-xs  { font-size: 15px; min-height: 36px; padding: 5px 11px; border-radius: var(--r-sm); }
.btn-icon { min-width: var(--tap); width: var(--tap); font-size: 24px; padding: 0; }

/* ---------- 首页 ---------- */

.screen-home {
  justify-content: center;
  align-items: center;
  text-align: center;
  /* 1.2.15 多了一行错题小怪物，整体间距收 2px 换回来，别把首页顶出屏幕。 */
  gap: 14px;
}

.home-title {
  font-size: 46px;
  font-weight: 800;
  letter-spacing: 4px;
  color: var(--c-primary-d);
  text-shadow: 0 3px 0 rgba(255,255,255,.9), 0 6px 16px rgba(244,112,63,.22);
}

.home-sub { font-size: 19px; color: var(--c-ink-soft); letter-spacing: 2px; margin-bottom: 4px; }

.home-stats { margin: 4px 0 10px; }

.home-points {
  font-size: 68px;
  font-weight: 800;
  color: var(--c-second);
  line-height: 1;
  text-shadow: 0 3px 0 rgba(255,255,255,.9);
}

.home-points-label { font-size: 17px; color: var(--c-ink-soft); letter-spacing: 4px; }

.home-row { display: flex; gap: var(--gap); width: 100%; max-width: 520px; }
.home-row .btn { flex: 1; }

/* 三科入口。一局只出一科。 */
.subject-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  max-width: 520px;
}

.subject-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.subject-emoji { font-size: 32px; }
.subject-name { font-size: 30px; font-weight: 800; letter-spacing: 4px; }

/* ---------- 三科闯关地图（1.2.16） ----------
 * 关卡点塞在原有三科按钮内部右侧，不新增一行：首页已经被徽章、进度条、
 * 小怪物占满，再叠一排会把底部复习按钮顶出小屏。白点在彩色按钮上都
 * 看得清；「下一关」用空心圈标出，没有循环动画。
 * 1.2.22：去掉按钮里的「第 5 轮 · 第 2 关」文字。那串 nowrap 文字是
 * 选课行里最占地方的元素，小屏上把三个按钮挤得又满又大。现在只留
 * 一排小点，尺寸顺带收一格；数据层 fullTitle / 累计进度全部照旧。 */
.level-inline {
  display: flex;
  align-items: center;
  margin-left: auto;
}
.level-track { display: flex; gap: 4px; }
.level-node {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: rgba(255,255,255,.32);
  border: 1px solid rgba(255,255,255,.65);
}
.level-done { background: #fff; border-color: #fff; }
.level-now { width: 12px; height: 12px; background: transparent; border: 2px solid #fff; }

.subject-en {
  background: linear-gradient(180deg, #8BE58B 0%, #66BB6A 100%);
  color: #fff;
}

.home-last { margin-top: 18px; font-size: 17px; color: var(--c-ink-soft); }

.screen-home .btn-xl { max-width: 520px; }

/* ---------- 徽章 ---------- */

.badge-strip {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
}

.badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  width: 74px;
  padding: 8px 4px;
  border-radius: var(--r-md);
  background: rgba(255,255,255,.55);
  border: 2px solid var(--c-line);
  opacity: .45;
  filter: grayscale(1);
  position: relative;
}

.badge-got {
  opacity: 1;
  filter: none;
  background: var(--c-bg-alt);
  border-color: var(--c-second);
  box-shadow: 0 4px 0 rgba(79,195,247,.25);
}

.badge-emoji { font-size: 30px; line-height: 1.1; }
.badge-name  { font-size: 14px; color: var(--c-ink-soft); }

/* 家长确认线下兑现后的小角标：绝对定位，不占徽章条高度。 */
.badge-claimed {
  position: absolute;
  top: -8px;
  right: -6px;
  padding: 1px 6px;
  border-radius: 999px;
  background: var(--c-ok);
  color: #fff;
  font-size: 12px;
  line-height: 1.4;
}

.home-sub-done { color: var(--c-ok); }

/* ---------- 错题小怪物 ----------
   纯静态 CSS 形状，不是循环动画；血量跟着 rightStreak 变，属于反馈型。 */

.monster-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  width: 100%;
  max-width: 520px;
}
.monster-hint { font-size: 14px; color: var(--c-ink-soft); }
.monster-tip  { font-size: 13px; color: var(--c-ink-soft); }
.monster-list { display: flex; gap: 6px; }
.monster { display: flex; flex-direction: column; align-items: center; gap: 2px; width: 26px; }
.monster-face {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  width: 24px;
  height: 20px;
  border-radius: 10px 10px 6px 6px;
  background: #B4A7E8;
}
.monster-t1 .monster-face { background: #7FD8FF; }
.monster-t2 .monster-face { background: #F5B971; }
.monster-eye { width: 4px; height: 4px; border-radius: 50%; background: #fff; }
.monster-hp { display: flex; gap: 2px; }
.hp-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  border: 1px solid var(--c-line);
  background: transparent;
}
.hp-dot.hp-on { background: var(--c-bad); border-color: var(--c-bad); }

.badge-progress {
  width: 100%;
  max-width: 520px;
  height: 14px;
  border-radius: 999px;
  background: #EFE7D6;
  overflow: hidden;
}

.badge-progress-bar {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #7FD8FF, var(--c-second));
  transition: width .4s ease;
}

.home-next { font-size: 16px; color: var(--c-ink-soft); }

/* ---------- 答题 ---------- */

.screen-game { padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); gap: 10px; }

.game-top {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.game-points-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.game-points {
  font-size: 18px;
  font-weight: 800;
  color: var(--c-second);
  white-space: nowrap;
  min-width: 62px;
  text-align: right;
}

.dots { display: flex; gap: 7px; flex: 1; justify-content: center; flex-wrap: wrap; }

.dot {
  width: 15px;
  height: 15px;
  border-radius: 50%;
  background: #E0D8C8;
  transition: all .25s;
}

.dot-now { background: var(--c-second); transform: scale(1.45); box-shadow: 0 0 0 4px rgba(79,195,247,.22); }
.dot-ok  { background: var(--c-ok); animation: dot-pop .42s ease-out; }
.dot-bad { background: var(--c-bad); }

/* 答对时该点弹一下，让孩子看见「进度往前走了一格」。
   class 从空变成 dot-ok 时动画天然重播，不需要额外触发。 */
@keyframes dot-pop {
  0%   { transform: scale(1); }
  45%  { transform: scale(1.6); }
  100% { transform: scale(1); }
}

.game-body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.q {
  width: 100%;
  max-width: 660px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  position: relative;
}

/* ---------- 切题入场（只在换题时播一次） ----------
   setData 只换文本不会重建节点，CSS 动画不会自己重播。所以用两个内容
   相同、名字不同的 keyframes 交替挂 class，每换一题强制重播一次。
   一律 backwards：错峰 delay 期间保持起始状态，播完立刻交还普通样式，
   不会覆盖 :active 和答对/答错的反馈动画。 */
.q-enter-a .stem-text { animation: stem-in-a .28s ease-out backwards; }
.q-enter-b .stem-text { animation: stem-in-b .28s ease-out backwards; }
.q-enter-a .option    { animation: opt-in-a .3s ease-out backwards; }
.q-enter-b .option    { animation: opt-in-b .3s ease-out backwards; }

@keyframes stem-in-a { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
@keyframes stem-in-b { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
@keyframes opt-in-a  { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
@keyframes opt-in-b  { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

.stem {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  width: 100%;
}

.stem-text {
  font-size: 40px;
  font-weight: 800;
  text-align: center;
  line-height: 1.35;
  color: var(--c-ink);
  letter-spacing: 2px;
}

/* ---------- 喇叭 ---------- */

.speaker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132px;
  height: 132px;
  padding: 0;
  margin: 0;
  color: #fff;
  background: linear-gradient(180deg, #7FD8FF 0%, var(--c-second) 100%);
  border: none;
  border-radius: 50%;
  box-shadow: 0 6px 0 #29A8DC, 0 10px 26px rgba(41,168,220,.32);
}

.speaker::after { border: none; }
.speaker-icon { font-size: 52px; line-height: 1; }
/* 只在「正在朗读」期间脉冲，且最多 3 次（约 1.65s）后自己停下。
   无限循环会一直抓孩子的眼睛 —— 这是状态指示，不是装饰。 */
.speaker.playing { animation: pulse .55s ease-in-out 3; }

/* 读题喇叭：同形，靠「读题」二字区分。只念题干，不念选项。 */
.read-stem { flex-direction: column; gap: 2px; }
.read-stem .speaker-icon { font-size: 40px; }
.read-stem .speaker-label { font-size: 15px; font-weight: 600; }

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.06); }
}

/* ---------- 数学计算题：十进制积木 ----------
   内容型演示，不是装饰：把算式里抽象的数字变成看得见的数量。
   动画只在换题 / 揭晓结果时各播一次，全部短促、无循环、无背景动效。 */
.visual {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,.7);
  border: 2px dashed var(--c-line);
  border-radius: var(--r-lg);
}

.v-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  width: 100%;
}
.v-num { display: flex; flex-direction: column; align-items: center; gap: 5px; min-width: 96px; }
.v-label { font-size: 26px; font-weight: 800; color: var(--c-ink); line-height: 1; }
.v-blocks {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 3px;
  max-width: 240px;
  min-height: 36px;
}
/* 一根棒上有十道刻度：孩子能看出「这一根 = 10」，不是随便一根棍子。 */
.v-bar {
  width: 14px;
  height: 36px;
  box-sizing: border-box;
  border: 2px solid #2E9BCF;
  border-radius: 4px;
  background: repeating-linear-gradient(180deg,
    #8FD9F8 0, #8FD9F8 2.6px, #2E9BCF 2.6px, #2E9BCF 3.4px);
}
.v-dot {
  width: 13px;
  height: 13px;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--c-primary);
  border: 2px solid var(--c-primary-d);
}
.v-zero { font-size: 22px; color: var(--c-ink-soft); }
.v-op { font-size: 36px; font-weight: 800; color: var(--c-primary-d); line-height: 1; }

/* 换题时操作数积木错峰淡入；交替 class 强制重播，和题干/选项同一套机制。
   限定 .v-row 下的块，结果行的块由 .v-result 整体带入，不重复播。 */
.q-enter-a .v-row .v-bar,
.q-enter-a .v-row .v-dot { animation: v-in-a .3s ease-out backwards; }
.q-enter-b .v-row .v-bar,
.q-enter-b .v-row .v-dot { animation: v-in-b .3s ease-out backwards; }
@keyframes v-in-a { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: none; } }
@keyframes v-in-b { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: none; } }

/* 作答后才出现：节点是 wx:if 新建的，动画每次都会播。 */
.v-result {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  width: 100%;
  padding-top: 8px;
  border-top: 2px solid var(--c-line);
  animation: v-result-in .38s ease-out backwards;
}
.v-eq { font-size: 32px; font-weight: 800; color: var(--c-ok); }
.v-label-result { color: var(--c-ok); }
/* 进位 / 借位题给一次性底色提示，不写字、不闪烁。 */
.v-regroup { animation: v-result-in .38s ease-out backwards, v-regroup-hint .5s ease-out .3s 1; }
@keyframes v-result-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
@keyframes v-regroup-hint { 0%, 100% { background: transparent; } 50% { background: #FFF3E0; } }

/* ---------- 拆数 / 凑十的积木方程 ---------- */
.v-split-top { display: flex; flex-direction: column; align-items: center; gap: 5px; }
.v-split-row {
  display: flex; align-items: center; justify-content: center;
  flex-wrap: wrap; gap: 8px; width: 100%;
}
.v-card {
  min-width: 84px;
  min-height: 62px;
  padding: 8px 10px;
  box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 4px;
  background: var(--c-bg-alt);
  border: 2px solid var(--c-line);
  border-radius: 14px;
}
/* 和题干/选项一样用交替 class 重播：setData 换文本不重建节点，动画不会自播。 */
.q-enter-a .v-card { animation: v-card-in-a .3s ease-out backwards; }
.q-enter-b .v-card { animation: v-card-in-b .3s ease-out backwards; }
@keyframes v-card-in-a { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
@keyframes v-card-in-b { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.v-card-unknown { border-style: dashed; border-color: var(--c-primary); }
.v-q { font-size: 36px; font-weight: 800; color: var(--c-primary-d); line-height: 1; }
.v-op-sm { font-size: 26px; }
.v-hint {
  display: flex; align-items: center; gap: 8px;
  padding: 4px 10px; border-radius: 10px; background: #FFF3E0;
}
.v-hint-num { font-size: 22px; font-weight: 800; color: var(--c-ink); }
.v-hint-op { font-size: 20px; font-weight: 800; color: var(--c-primary-d); }
.v-bar-hint { height: 26px; width: 12px; }

/* ---------- 分步讲解：进位 / 借位 / 凑十的过程帧（1.2.12） ----------
   两帧并排，未到的帧压暗；stepNow 推进时只把当前帧点亮并播一次弹跳。
   没有循环、没有背景动效，眼睛始终跟着「这一步变了什么」。 */
.v-steps {
  display: flex; align-items: center; justify-content: center;
  flex-wrap: wrap; gap: 8px; width: 100%;
  padding-top: 8px; border-top: 2px dashed var(--c-line);
}
.v-step-arrow { font-size: 22px; font-weight: 800; color: var(--c-ink-soft); }
.v-step {
  min-width: 76px; min-height: 52px;
  padding: 6px 8px; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  background: var(--c-bg-alt); border: 2px solid var(--c-line);
  border-radius: 12px;
  opacity: .3;
  transition: opacity .22s ease-out, border-color .22s ease-out;
}
.v-step-on {
  opacity: 1; border-color: var(--c-primary);
  animation: v-step-pop .36s ease-out 1;
}
@keyframes v-step-pop {
  0%   { transform: scale(.88); }
  55%  { transform: scale(1.06); }
  100% { transform: scale(1); }
}
/* 帧里积木小一号，借位题「9 根棒 → 8 根棒 + 14 个点」才塞得进一张卡片。 */
.v-step .v-blocks { max-width: 190px; min-height: 0; gap: 2px; }
.v-step .v-bar { width: 10px; height: 26px; }
.v-step .v-dot { width: 10px; height: 10px; }

/* 要搬走的圆点：橙色 + 一次向左的小位移，表达「拿过去凑十」。
   动画挂在 .v-step-on 下，帧没点亮时不会偷偷演完。 */
.v-step-on .v-dot-take {
  background: var(--c-warn); border-color: #D97B22;
  animation: v-dot-move .5s ease-out 1;
}
@keyframes v-dot-move {
  0%   { transform: translateX(8px); }
  60%  { transform: translateX(-5px); }
  100% { transform: none; }
}
/* 剩下的点浅一点，别和「要搬走的」抢眼睛。 */
.v-dot-rest { background: #CFE8F5; border-color: #9BC9E0; }
/* 被减掉的点：半透明 + 虚线，表示划掉。 */
.v-dot-cut { opacity: .35; border-style: dashed; background: transparent; }
/* 新凑出来的十棒：换成绿色刻度并放大出现，仍是「一根有十道刻度的棒」。 */
.v-step-on .v-bar-new {
  border-color: #43A047;
  background: repeating-linear-gradient(180deg,
    #A5D6A7 0, #A5D6A7 2px, #43A047 2px, #43A047 2.8px);
  animation: v-bar-grow .42s ease-out 1;
}
@keyframes v-bar-grow {
  0%   { transform: scale(.5); opacity: .3; }
  60%  { transform: scale(1.16); opacity: 1; }
  100% { transform: scale(1); }
}
/* 要拆开的十棒：虚线，下一帧它就变成 10 个圆点。 */
.v-bar-break { border-style: dashed; border-color: var(--c-warn); }

/* ---------- 英语词族 / 音位格子 / 拼音拆合 ---------- */
.v-blend { display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%; }
.v-chip {
  min-width: 56px;
  padding: 10px 16px;
  box-sizing: border-box;
  text-align: center;
  font-size: 30px;
  font-weight: 800;
  color: var(--c-ink);
  background: var(--c-bg-alt);
  border: 3px solid var(--c-line);
  border-radius: 14px;
}
.q-enter-a .v-chip { animation: v-chip-in-a .34s ease-out backwards; }
.q-enter-b .v-chip { animation: v-chip-in-b .34s ease-out backwards; }
@keyframes v-chip-in-a { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: none; } }
@keyframes v-chip-in-b { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: none; } }
/* 两块先来、合成结果最后到，孩子看到的是「拼起来」这个动作。 */
.v-chip:nth-child(3) { animation-delay: .14s; }
.v-chip-full { border-color: var(--c-ok); color: var(--c-ok); animation-delay: .34s; }
.v-chip-sheng { border-color: var(--c-second); }
.v-chip-yun { border-color: var(--c-primary); }
.v-blend-arrow { font-size: 26px; font-weight: 800; color: var(--c-ink-soft); }

.v-slots { display: flex; align-items: center; justify-content: center; gap: 12px; padding: 6px 0; }
.v-slot {
  width: 22px; height: 22px; box-sizing: border-box;
  border-radius: 50%; border: 3px solid var(--c-second); background: transparent;
}
/* 只在单词音频真正开始播的那一刻挂上 pulse class，格子才跟着声音依次亮。 */
.v-slots-pulse-a .v-slot { animation: v-slot-a .34s ease-out backwards; }
.v-slots-pulse-b .v-slot { animation: v-slot-b .34s ease-out backwards; }
@keyframes v-slot-a { 0%,100% { background: transparent; transform: scale(1); } 45% { background: var(--c-second); transform: scale(1.25); } }
@keyframes v-slot-b { 0%,100% { background: transparent; transform: scale(1); } 45% { background: var(--c-second); transform: scale(1.25); } }

.v-letters {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding-top: 8px; border-top: 2px solid var(--c-line);
}
.v-letter {
  min-width: 40px;
  padding: 6px 4px;
  box-sizing: border-box;
  text-align: center;
  font-size: 28px;
  font-weight: 800;
  color: var(--c-ok);
  background: #E8F5E9;
  border: 2px solid var(--c-ok);
  border-radius: 10px;
}
.v-letters-pulse-a .v-letter { animation: v-letter-a .34s ease-out backwards; }
.v-letters-pulse-b .v-letter { animation: v-letter-b .34s ease-out backwards; }
@keyframes v-letter-a { 0%,100% { transform: scale(1); background: #E8F5E9; } 45% { transform: scale(1.18); background: #C8E6C9; } }
@keyframes v-letter-b { 0%,100% { transform: scale(1); background: #E8F5E9; } 45% { transform: scale(1.18); background: #C8E6C9; } }

/* 听音选字母：作答后把音频里的词摆出来，开头那个字母标绿，
   让「听到的第一个音」和要选的大写字母对上。 */
.v-letter-lead { color: #1B7A3E; border-color: #1B7A3E; background: #C8E6C9; }

/* ---------- 找规律 / 通用对照卡（1.2.16） ---------- */

.v-seq {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  width: 100%;
}
.v-seq-card {
  min-width: 58px;
  padding: 10px 8px;
  box-sizing: border-box;
  text-align: center;
  font-size: 26px;
  font-weight: 800;
  color: var(--c-ink);
  background: var(--c-bg-alt);
  border: 3px solid var(--c-line);
  border-radius: 14px;
}
.q-enter-a .v-seq-card { animation: v-chip-in-a .34s ease-out backwards; }
.q-enter-b .v-seq-card { animation: v-chip-in-b .34s ease-out backwards; }
.v-seq-unknown { border-style: dashed; border-color: var(--c-primary); color: var(--c-primary-d); }
.v-seq-gap { font-size: 18px; font-weight: 800; color: var(--c-ok); }
.v-seq-dot { font-size: 18px; color: var(--c-ink-soft); }

.v-pair {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  width: 100%;
}
.v-pair-left { border-color: var(--c-second); }
.v-pair-right { border-style: dashed; border-color: var(--c-primary); color: var(--c-primary-d); }
.v-pair-big { font-size: 44px; min-width: 76px; }
.v-pair-op { font-size: 20px; font-weight: 800; color: var(--c-ink-soft); }

/* ---------- 选项 ---------- */

.options { display: grid; gap: var(--gap); width: 100%; }
.options-grid { grid-template-columns: 1fr 1fr; }
.options-row  { grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); }
.options-big-number { grid-template-columns: 1fr 1fr; }

.option {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84px;
  padding: 16px 20px;
  margin: 0;
  font-size: 32px;
  font-weight: 700;
  line-height: 1.25;
  color: var(--c-ink);
  background: var(--c-bg-alt);
  border: 3px solid var(--c-line);
  border-radius: var(--r-lg);
  box-shadow: 0 4px 0 rgba(0,0,0,.07);
  word-break: break-word;
}

.option::after { border: none; }

.option-single .option-text { font-size: 50px; }

.options-big-number .option-text { font-size: 46px; letter-spacing: 2px; }
.q-layout-big-number .stem-text { font-size: 52px; letter-spacing: 4px; }

.option.locked { opacity: .62; }
.option.is-answer {
  opacity: 1;
  border-color: var(--c-ok);
  background: #E8F5E9;
}
/* 对勾用真实节点而不是 ::after —— button 的 ::after 已经被用来清掉
   默认边框，再往里塞 content 在部分基础库上不显示。 */
.option-check {
  position: absolute;
  top: 6px;
  right: 12px;
  font-size: 22px;
  color: var(--c-ok);
}

.option.is-wrong {
  opacity: 1;
  border-color: var(--c-bad);
  background: #FFEBEE;
}

/* ---------- 解释 ---------- */

.explain {
  width: 100%;
  padding: 14px 18px;
  font-size: 19px;
  line-height: 1.6;
  text-align: center;
  color: #7A3B1E;
  background: #FFF3E0;
  border-radius: var(--r-md);
  border-left: 5px solid var(--c-warn);
  animation: screen-in .22s ease-out;
}

/* ---------- 反馈动画 ---------- */

/* 特异性要高于 .q-enter-* .option，否则答对时入场动画会把反馈动画盖掉。 */
.q .option.fb-ok  { animation: pop-ok .5s ease-out; }
.q .option.fb-bad { animation: flash-bad .5s ease-out; }

@keyframes pop-ok {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes flash-bad {
  0%, 100% { background: inherit; }
  30%      { background: #FFEBEE; }
}

.shake { animation: shake .45s cubic-bezier(.36,.07,.19,.97); }

@keyframes shake {
  10%, 90% { transform: translateX(-3px); }
  20%, 80% { transform: translateX(5px); }
  30%, 50%, 70% { transform: translateX(-7px); }
  40%, 60% { transform: translateX(7px); }
}

.confetti {
  position: absolute;
  top: -12px;
  width: 11px;
  height: 11px;
  border-radius: 3px;
  pointer-events: none;
  animation: confetti-fall 1.3s ease-in forwards;
}

@keyframes confetti-fall {
  0%   { opacity: 1; transform: translateY(0) rotate(0deg); }
  100% { opacity: 0; transform: translateY(320px) rotate(560deg); }
}

/* 答题页答对后 620ms 就切题，1.3s 的彩纸每次只播一半就被销毁。
   答题页压到 550ms 一次演完；结算页停留时间长，仍用完整的 1.3s。 */
.confetti.confetti-quick { animation-duration: .55s; }

/* ---------- 本局答对数（即时反馈，不碰星星账目） ----------
   真账目在整局结束时结算（有每日上限削减），过程中只显示「本局 ✓N」，
   逐题改 save.points 会和审计、上限对不上。 */
.round-score-wrap { position: relative; min-width: 74px; }
.round-score {
  font-size: 15px;
  font-weight: 700;
  color: var(--c-ink-soft);
  white-space: nowrap;
}
.star-pop {
  position: absolute;
  top: -16px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20px;
  font-weight: 800;
  color: var(--c-warn);
  pointer-events: none;
  animation: star-pop .5s ease-out backwards;
}
@keyframes star-pop {
  0%   { opacity: 0; transform: translateY(10px) scale(.8); }
  35%  { opacity: 1; transform: translateY(-4px) scale(1.15); }
  100% { opacity: 0; transform: translateY(-22px) scale(1); }
}

/* 答错后要停 1500ms 才切题。给一条会走完的进度条，孩子知道还有多久，
   而不是毫无征兆地被翻走。 */
.explain-timer {
  width: 100%;
  max-width: 460px;
  height: 6px;
  border-radius: 999px;
  background: #F3E2CE;
  overflow: hidden;
}
.explain-timer-bar {
  height: 100%;
  width: 100%;
  border-radius: 999px;
  background: var(--c-warn);
  animation: timer-shrink 1.5s linear forwards;
}
/* 分步题的切题窗口是 1900ms，倒计时条要走满，别提前归零误导孩子。 */
.explain-timer-bar.explain-timer-long { animation-duration: 1.9s; }
@keyframes timer-shrink { from { width: 100%; } to { width: 0%; } }

/* ---------- 结算 ---------- */

.screen-summary {
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 14px;
}

.summary-subject { font-size: 20px; color: var(--c-ink-soft); letter-spacing: 4px; }
.summary-emoji { font-size: 76px; line-height: 1; animation: pop-ok .7s ease-out; }
.summary-title { font-size: 34px; font-weight: 800; color: var(--c-primary-d); }
.summary-score { font-size: 54px; font-weight: 800; color: var(--c-second); letter-spacing: 3px; }

.summary-card {
  width: 100%;
  max-width: 460px;
  margin: 14px 0;
  padding: 18px;
  background: var(--c-bg-alt);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow);
}

.screen-summary .btn { max-width: 460px; width: 100%; }

/* 「再练一次错题」是打完一局最自然的下一步：不抢主按钮，但用暖色描边
   和徽章解锁提示同一套颜色，让孩子一眼能找到。 */
.btn-review {
  background: #FFF3E0;
  border: 2px solid var(--c-warn);
  color: #7A3B1E;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 9px 0;
  font-size: 18px;
  border-bottom: 1px solid var(--c-line);
}

.stat-row:last-child { border-bottom: none; }
.stat-label { color: var(--c-ink-soft); }
.stat-value { font-weight: 800; }

.summary-note {
  font-size: 17px;
  color: var(--c-ink-soft);
  padding: 0 12px;
}

.badge-unlock {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 18px;
  border-radius: var(--r-md);
  background: #FFF3E0;
  border-left: 5px solid var(--c-warn);
  animation: pop-ok .7s ease-out, unlock-glow .9s ease-out;
}

/* 一次性扩散光环，不是循环呼吸 —— 解锁是这一局最值得看的一眼。 */
@keyframes unlock-glow {
  0%   { box-shadow: 0 0 0 0 rgba(255,183,77,.85); }
  100% { box-shadow: 0 0 0 22px rgba(255,183,77,0); }
}

.badge-unlock-emoji { font-size: 30px; }
.badge-unlock-text { font-size: 18px; font-weight: 700; color: #7A3B1E; }

/* ---------- 大字模式（1.2.16，家长开关，默认关） ----------
 * 只放大「孩子要读的字」：题干、选项、科目名、结算数字、解释。
 * 徽章角标、家长面板、进度条一律不动 —— 家长面板是长滚动页，放大
 * 会把开关挤出屏幕。根 class 挂在三个孩子可见页面的 .screen 上，
 * 老存档没有 settings.bigText 时这些规则一条都不生效。 */
.big-text .stem-text { font-size: 50px; }
.big-text .q-layout-big-number .stem-text { font-size: 62px; }
.big-text .option-text { font-size: 36px; }
.big-text .option-single .option-text { font-size: 62px; }
.big-text .options-big-number .option-text { font-size: 56px; }
.big-text .explain { font-size: 24px; }
.big-text .subject-name { font-size: 36px; }
.big-text .home-sub { font-size: 22px; }
.big-text .home-next { font-size: 19px; }
.big-text .home-last { font-size: 19px; }
.big-text .badge-name { font-size: 17px; }
.big-text .summary-subject { font-size: 24px; }
.big-text .summary-title { font-size: 40px; }
.big-text .summary-score { font-size: 62px; }
.big-text .stat-row { font-size: 21px; }
.big-text .v-label { font-size: 30px; }
.big-text .v-chip { font-size: 34px; }
.big-text .v-letter { font-size: 32px; }
