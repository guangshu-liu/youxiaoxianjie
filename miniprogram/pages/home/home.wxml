<view class="screen screen-home {{bigText ? 'big-text' : ''}}">
  <view class="home-title">幼小衔接闯关</view>
  <view class="home-sub {{goalReached ? 'home-sub-done' : ''}}">{{subTitle}}</view>

  <view class="home-stats">
    <view class="home-points">{{stars}}</view>
    <view class="home-points-label">星星</view>
  </view>

  <view class="badge-strip">
    <view wx:for="{{badges}}" wx:key="need" class="badge {{item.got ? 'badge-got' : ''}}">
      <text class="badge-emoji">{{item.emoji}}</text>
      <text class="badge-name">{{item.name}}</text>
      <text wx:if="{{item.claimed}}" class="badge-claimed">已换</text>
    </view>
  </view>

  <view class="badge-progress">
    <view class="badge-progress-bar" style="width:{{progressPct}}%"></view>
  </view>

  <view class="home-next" wx:if="{{nextBadge}}">
    再攒 {{nextBadge.left}} 颗星星，解锁「{{nextBadge.name}}」
  </view>
  <view class="home-next" wx:else>四个徽章都拿到啦！</view>

  <view wx:if="{{monsters.length}}" class="monster-row">
    <text class="monster-hint">错题小怪物 {{monsterTotal}} 只</text>
    <view class="monster-list">
      <view wx:for="{{monsters}}" wx:key="id" class="monster monster-t{{item.tone}}">
        <view class="monster-face"><view class="monster-eye"></view><view class="monster-eye"></view></view>
        <view class="monster-hp">
          <view class="hp-dot {{item.hp >= 1 ? 'hp-on' : ''}}"></view>
          <view class="hp-dot {{item.hp >= 2 ? 'hp-on' : ''}}"></view>
        </view>
      </view>
    </view>
    <text class="monster-tip">连对 2 次收服</text>
  </view>

  <view class="subject-list">
    <button class="btn btn-primary btn-xl subject-btn" data-subject="chinese" bindtap="onStart">
      <text class="subject-emoji">📖</text><text class="subject-name">语文</text>
      <view wx:if="{{levels}}" class="level-inline">
        <view class="level-track">
          <view wx:for="{{levels.chinese.nodes}}" wx:key="i" class="level-node {{item.done ? 'level-done' : ''}} {{item.now ? 'level-now' : ''}}"></view>
        </view>
      </view>
    </button>
    <button class="btn btn-secondary btn-xl subject-btn" data-subject="math" bindtap="onStart">
      <text class="subject-emoji">🔢</text><text class="subject-name">数学</text>
      <view wx:if="{{levels}}" class="level-inline">
        <view class="level-track">
          <view wx:for="{{levels.math.nodes}}" wx:key="i" class="level-node {{item.done ? 'level-done' : ''}} {{item.now ? 'level-now' : ''}}"></view>
        </view>
      </view>
    </button>
    <button class="btn btn-xl subject-btn subject-en" data-subject="english" bindtap="onStart">
      <text class="subject-emoji">🔤</text><text class="subject-name">英语</text>
      <view wx:if="{{levels}}" class="level-inline">
        <view class="level-track">
          <view wx:for="{{levels.english.nodes}}" wx:key="i" class="level-node {{item.done ? 'level-done' : ''}} {{item.now ? 'level-now' : ''}}"></view>
        </view>
      </view>
    </button>
  </view>

  <view class="home-row">
    <button wx:if="{{reviewRoundSize >= 3}}" class="btn btn-ghost" bindtap="onReview">🔁 复习错题（本局 {{reviewRoundSize}} 题）</button>
    <button class="btn btn-ghost" bindtap="onParent">👨‍👩‍👧 家长</button>
  </view>

  <view class="home-last" wx:if="{{lastText}}">{{lastText}}</view>
</view>
