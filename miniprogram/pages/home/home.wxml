<view class="screen screen-home {{bigText ? 'big-text' : ''}}">
  <!-- 1.2.24 极简版：标题本来就在导航栏里，首页顶部不再重复堆信息。
       只留右上角一枚状态胶囊，星星数与徽章解锁状态仍看得见；
       徽章名称、兑现记录、进度条在家长页与结算页，数据一个不删。 -->
  <view class="home-mini">
    <text class="home-mini-stars">⭐ {{stars}}</text>
    <view class="home-mini-badges">
      <text wx:for="{{badges}}" wx:key="need" class="home-mini-badge {{item.got ? 'is-got' : ''}}">{{item.emoji}}</text>
    </view>
  </view>

  <view class="subject-list">
    <button class="subject-btn subject-cn" data-subject="chinese" bindtap="onStart">
      <text class="subject-emoji">📖</text>
      <view class="subject-name"><text>语</text><text>文</text></view>
      <view wx:if="{{levels}}" class="level-inline">
        <view class="level-track">
          <view wx:for="{{levels.chinese.nodes}}" wx:key="i" class="level-node {{item.done ? 'level-done' : ''}} {{item.now ? 'level-now' : ''}}"></view>
        </view>
      </view>
    </button>
    <button class="subject-btn subject-ma" data-subject="math" bindtap="onStart">
      <text class="subject-emoji">🔢</text>
      <view class="subject-name"><text>数</text><text>学</text></view>
      <view wx:if="{{levels}}" class="level-inline">
        <view class="level-track">
          <view wx:for="{{levels.math.nodes}}" wx:key="i" class="level-node {{item.done ? 'level-done' : ''}} {{item.now ? 'level-now' : ''}}"></view>
        </view>
      </view>
    </button>
    <button class="subject-btn subject-en" data-subject="english" bindtap="onStart">
      <text class="subject-emoji">🔤</text>
      <view class="subject-name"><text>英</text><text>语</text></view>
      <view wx:if="{{levels}}" class="level-inline">
        <view class="level-track">
          <view wx:for="{{levels.english.nodes}}" wx:key="i" class="level-node {{item.done ? 'level-done' : ''}} {{item.now ? 'level-now' : ''}}"></view>
        </view>
      </view>
    </button>
  </view>

  <view class="home-row">
    <button wx:if="{{reviewRoundSize >= 3}}" class="btn btn-ghost home-action" bindtap="onReview">🔁 复习错题（本局 {{reviewRoundSize}} 题）</button>
    <button class="btn btn-ghost home-action" bindtap="onParent">👨‍👩‍👧 家长</button>
  </view>
</view>
