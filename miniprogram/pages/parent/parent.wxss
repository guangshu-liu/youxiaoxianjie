/* 家长面板。窄屏上是长滚动页，所以用 scroll-view + 固定高度。 */

.screen-parent {
  display: block;
  height: 100vh;
  padding: 12px 16px calc(40px + env(safe-area-inset-bottom));
}

/* ---------- 门禁 ---------- */

.gate-screen {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 14px;
  height: auto;
  min-height: 100vh;
  text-align: center;
}

.panel-title {
  font-size: 26px;
  font-weight: 800;
  margin: 8px 0 10px;
  color: var(--c-ink);
}

.gate-q {
  font-size: 34px;
  font-weight: 800;
  color: var(--c-primary-d);
  letter-spacing: 2px;
}

.gate-input {
  width: 100%;
  max-width: 320px;
  height: 68px;
  padding: 0 18px;
  font-size: 30px;
  text-align: center;
  background: #fff;
  border: 3px solid var(--c-line);
  border-radius: var(--r-md);
}

.gate-err {
  font-size: 18px;
  color: var(--c-bad);
}

.gate-screen .btn { width: 100%; max-width: 320px; }

/* ---------- 区块 ---------- */

.p-section { margin: 18px 0; }

.p-section-title {
  font-size: 20px;
  font-weight: 800;
  color: var(--c-ink);
  margin: 0 0 8px 4px;
}

.stat-card {
  padding: 16px;
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--shadow);
}

.stat-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--c-ink-soft);
  margin: 14px 0 8px;
}

.muted { color: var(--c-ink-soft); font-size: 15px; line-height: 1.6; }

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 9px 0;
  font-size: 18px;
  border-bottom: 1px solid var(--c-line);
}

.stat-row:last-child { border-bottom: none; }
.stat-label { color: var(--c-ink-soft); }
.stat-value { font-weight: 800; }

.audit-bad {
  margin-top: 10px;
  padding: 10px 12px;
  font-size: 15px;
  color: #C62828;
  background: #FFF5F5;
  border-radius: var(--r-sm);
}

.warn-card {
  margin: 12px 0;
  padding: 14px 16px;
  background: #FFFBF0;
  border-left: 5px solid var(--c-warn);
  border-radius: var(--r-md);
  font-size: 17px;
  line-height: 1.7;
}

.warn-card .btn { margin-top: 10px; }

/* ---------- 字表 ---------- */

.zi-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 6px;
}

.zi-chip {
  min-width: 38px;
  height: 38px;
  line-height: 38px;
  padding: 0 6px;
  text-align: center;
  font-size: 20px;
  color: var(--c-ink);
  background: #F6F1E4;
  border-radius: var(--r-sm);
}

.zi-chip-weak {
  color: #C62828;
  background: #FFEBEE;
  font-weight: 800;
}

/* ---------- 进度条 ---------- */

.bar-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 0;
  font-size: 15px;
}

.bar-label {
  flex: 0 0 40%;
  color: var(--c-ink-soft);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bar-track {
  flex: 1;
  height: 12px;
  background: #EFE7D6;
  border-radius: 999px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #7FD8FF, var(--c-second));
}

.bar-pct {
  flex: 0 0 44px;
  text-align: right;
  font-weight: 700;
  color: var(--c-ink);
}

/* ---------- 错题 ---------- */

.wrong-row {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 9px 0;
  font-size: 15px;
  border-bottom: 1px dashed var(--c-line);
}

.wrong-row:last-child { border-bottom: none; }
.wrong-stem { flex: 1; color: var(--c-ink); }
.wrong-count { color: var(--c-bad); white-space: nowrap; }

/* ---------- 备份 ---------- */

.backup-hint {
  font-size: 15px;
  color: var(--c-ink-soft);
  margin-bottom: 10px;
}

.backup-warn { color: #C62828; font-weight: 700; }

.import-area {
  width: 100%;
  height: 140px;
  margin: 12px 0;
  padding: 12px;
  font-size: 14px;
  background: #FAF6EC;
  border: 2px solid var(--c-line);
  border-radius: var(--r-md);
  box-sizing: border-box;
}

.stat-card .btn { width: 100%; margin: 6px 0; }
