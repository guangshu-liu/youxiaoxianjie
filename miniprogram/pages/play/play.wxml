<view class="screen screen-game {{bigText ? 'big-text' : ''}}">
  <view class="game-top">
    <button class="btn btn-icon" bindtap="onExit">✕</button>

    <view class="dots">
      <view
        wx:for="{{dots}}"
        wx:key="i"
        class="dot dot-{{item.state}}"></view>
    </view>

    <view class="game-points-wrap">
      <view class="game-points">{{stars}}★</view>
      <view class="round-score-wrap">
        <text class="round-score">本局 ✓{{roundCorrect}}</text>
        <view wx:if="{{starPop}}" class="star-pop">+1 ★</view>
      </view>
    </view>
  </view>

  <view class="game-body">
    <view class="q q-layout-{{layout}} q-enter-{{enterFlag}} {{shake ? 'shake' : ''}}">
      <view class="stem">
        <view class="stem-text">{{stemText}}</view>
        <button wx:if="{{hasAudio}}" class="speaker" bindtap="onSpeaker">
          <text class="speaker-icon">🔊</text>
        </button>
        <!-- 只朗读题干：听音题走上面的单词音频，其余题才有这个按钮 -->
        <button wx:if="{{canRead}}" class="speaker read-stem {{speaking ? 'playing' : ''}}" bindtap="onReadStem">
          <text class="speaker-icon">🔊</text>
          <text class="speaker-label">读题</text>
        </button>
      </view>

      <!-- 内容型演示：按题目的 kind 选模板。共同纪律：答题前不显示得数。
           math-calc 一根十棒 = 10、一个圆点 = 1（1.2.16 起也用于应用题）；
           math-split 问号原位翻答案；math-sequence 找规律只摆题干的数；
           pair 是「已知项 → 问什么 → ?」通用对照卡；
           english 答题前只给词族/音位格子、作答后才出字母；pinyin 拆声母韵母。 -->
      <view wx:if="{{visual}}" class="visual visual-{{visual.kind}}">

        <!-- 数学计算题 -->
        <block wx:if="{{visual.kind === 'math-calc'}}">
          <view class="v-row">
            <view class="v-num">
              <text class="v-label">{{visual.left.label}}</text>
              <view class="v-blocks">
                <view wx:for="{{visual.left.bars}}" wx:for-item="bar" wx:key="i" class="v-bar" style="animation-delay:{{bar.delay}}s"></view>
                <view wx:for="{{visual.left.dots}}" wx:for-item="dot" wx:key="i" class="v-dot" style="animation-delay:{{dot.delay}}s"></view>
                <text wx:if="{{visual.left.empty}}" class="v-zero">0</text>
              </view>
            </view>
            <text class="v-op">{{visual.opLabel}}</text>
            <view class="v-num">
              <text class="v-label">{{visual.right.label}}</text>
              <view class="v-blocks">
                <view wx:for="{{visual.right.bars}}" wx:for-item="bar" wx:key="i" class="v-bar" style="animation-delay:{{bar.delay}}s"></view>
                <view wx:for="{{visual.right.dots}}" wx:for-item="dot" wx:key="i" class="v-dot" style="animation-delay:{{dot.delay}}s"></view>
                <text wx:if="{{visual.right.empty}}" class="v-zero">0</text>
              </view>
            </view>
          </view>
        </block>

        <!-- 拆数 / 凑十：原数在上，拆开的块在下，问号原位翻出答案 -->
        <block wx:elif="{{visual.kind === 'math-split'}}">
          <view wx:if="{{visual.top}}" class="v-split-top">
            <text class="v-label">{{visual.top.label}}</text>
            <view class="v-blocks">
              <view wx:for="{{visual.top.bars}}" wx:for-item="bar" wx:key="i" class="v-bar"></view>
              <view wx:for="{{visual.top.dots}}" wx:for-item="dot" wx:key="i" class="v-dot"></view>
            </view>
          </view>
          <view wx:if="{{visual.hint}}" class="v-hint">
            <text class="v-hint-num">{{visual.hint.a}}</text>
            <text class="v-hint-op">+</text>
            <text class="v-hint-num">{{visual.hint.c}}</text>
            <text class="v-hint-op">→</text>
            <view class="v-bar v-bar-hint"></view>
            <text class="v-hint-num">10</text>
          </view>
          <view class="v-split-row">
            <block wx:for="{{visual.parts}}" wx:for-item="part" wx:key="i" wx:for-index="pi">
              <text wx:if="{{pi > 0}}" class="v-op v-op-sm">+</text>
              <view class="v-card {{part.unknown ? 'v-card-unknown' : ''}}" style="animation-delay:{{part.delay}}s">
                <block wx:if="{{part.unknown}}">
                  <text wx:if="{{!revealed}}" class="v-q">?</text>
                  <block wx:else>
                    <text class="v-label v-label-result">{{part.solved.label}}</text>
                    <view class="v-blocks">
                      <view wx:for="{{part.solved.bars}}" wx:for-item="bar" wx:key="i" class="v-bar"></view>
                      <view wx:for="{{part.solved.dots}}" wx:for-item="dot" wx:key="i" class="v-dot"></view>
                      <text wx:if="{{part.solved.empty}}" class="v-zero">0</text>
                    </view>
                  </block>
                </block>
                <block wx:else>
                  <text class="v-label">{{part.label}}</text>
                  <view class="v-blocks">
                    <view wx:for="{{part.bars}}" wx:for-item="bar" wx:key="i" class="v-bar"></view>
                    <view wx:for="{{part.dots}}" wx:for-item="dot" wx:key="i" class="v-dot"></view>
                    <text wx:if="{{part.empty}}" class="v-zero">0</text>
                  </view>
                </block>
              </view>
            </block>
          </view>
        </block>

        <!-- 英语：答题前摆词族或音位格子，作答后才出字母 -->
        <block wx:elif="{{visual.kind === 'english'}}">
          <view wx:if="{{visual.before.type === 'split'}}" class="v-blend">
            <view class="v-chip">{{visual.before.onset}}</view>
            <text class="v-op v-op-sm">+</text>
            <view class="v-chip">{{visual.before.rime}}</view>
            <block wx:if="{{!answered}}">
              <text class="v-blend-arrow">→</text>
              <text class="v-q">?</text>
            </block>
          </view>
          <!-- 作答后格子让位给字母卡片，避免两层提示叠在一起。 -->
          <view wx:elif="{{!answered}}" class="v-slots {{slotsClass}}">
            <view wx:for="{{visual.before.slots}}" wx:for-item="slot" wx:key="i" class="v-slot" style="animation-delay:{{slot.delay}}s"></view>
          </view>
          <view wx:if="{{answered}}" class="v-letters {{lettersClass}}">
            <view wx:for="{{visual.after.letters}}" wx:for-item="L" wx:key="i" class="v-letter {{L.cls}}" style="animation-delay:{{L.delay}}s">{{L.ch}}</view>
          </view>
        </block>

        <!-- 拼音：声母 + 韵母 → 完整拼音（题干里本来就有，不算泄答案） -->
        <block wx:elif="{{visual.kind === 'pinyin'}}">
          <view class="v-blend v-pinyin">
            <view class="v-chip v-chip-sheng">{{visual.sheng}}</view>
            <text class="v-op v-op-sm">+</text>
            <view class="v-chip v-chip-yun">{{visual.yun}}</view>
            <text class="v-blend-arrow">→</text>
            <view class="v-chip v-chip-full">{{visual.full}}</view>
          </view>
        </block>

        <!-- 找规律：题干里的三个数摆成卡片；「每次 +N」是解题过程，
             和分步帧一样只在 revealed 之后亮，答题前一格都不露。 -->
        <block wx:elif="{{visual.kind === 'math-sequence'}}">
          <view class="v-seq">
            <block wx:for="{{visual.items}}" wx:for-item="it" wx:key="i">
              <view class="v-seq-card">{{it.label}}</view>
              <text wx:if="{{revealed}}" class="v-seq-gap">{{it.gap}}</text>
              <text wx:else class="v-seq-dot">·</text>
            </block>
            <view class="v-seq-card v-seq-unknown">
              <text wx:if="{{!revealed}}">?</text>
              <text wx:else>{{visual.answer.label}}</text>
            </view>
          </view>
        </block>

        <!-- 通用对照卡：题干给的已知项 → 问的是什么 → ?，作答后原位翻答案 -->
        <block wx:elif="{{visual.kind === 'pair'}}">
          <view class="v-pair">
            <view class="v-chip v-pair-left {{visual.big ? 'v-pair-big' : ''}}">{{visual.left}}</view>
            <text class="v-pair-op">{{visual.op}}</text>
            <view class="v-chip v-pair-right {{visual.big ? 'v-pair-big' : ''}}">
              <text wx:if="{{!revealed}}">?</text>
              <text wx:else>{{visual.answer.label}}</text>
            </view>
          </view>
        </block>

        <!-- 进位 / 借位 / 凑十：作答后才演「怎么算」。两帧过程依次点亮，
             第三步才由 revealed 打开下面的结果行 / 让问号翻出得数。
             答题前整个 v-steps 连节点都不渲染，一个得数都不露。 -->
        <view wx:if="{{answered && visual.steps}}" class="v-steps">
          <block wx:for="{{visual.steps.frames}}" wx:for-item="fr" wx:key="i">
            <text wx:if="{{fr.i > 0}}" class="v-step-arrow">→</text>
            <view class="v-step {{stepNow >= fr.i ? 'v-step-on' : ''}}">
              <view class="v-blocks">
                <view wx:for="{{fr.bars}}" wx:for-item="bar" wx:key="i" class="v-bar {{bar.cls}}"></view>
                <view wx:for="{{fr.dots}}" wx:for-item="dot" wx:key="i" class="v-dot {{dot.cls}}"></view>
              </view>
            </view>
          </block>
        </view>

        <!-- 得数积木：没有分步的题作答即揭晓；有分步的题等两帧演完。 -->
        <view wx:if="{{revealed && visual.kind === 'math-calc'}}"
              class="v-result {{visual.regroup ? 'v-regroup' : ''}}">
          <text class="v-eq">=</text>
          <view class="v-num">
            <text class="v-label v-label-result">{{visual.result.label}}</text>
            <view class="v-blocks">
              <view wx:for="{{visual.result.bars}}" wx:for-item="bar" wx:key="i" class="v-bar"></view>
              <view wx:for="{{visual.result.dots}}" wx:for-item="dot" wx:key="i" class="v-dot"></view>
              <text wx:if="{{visual.result.empty}}" class="v-zero">0</text>
            </view>
          </view>
        </view>
      </view>

      <view class="options options-{{layout}}">
        <button
          wx:for="{{options}}"
          wx:key="id"
          class="option {{item.single ? 'option-single' : ''}} {{item.state === 'answer' ? 'is-answer' : ''}} {{item.state === 'wrong' ? 'is-wrong' : ''}} {{item.state ? 'locked' : ''}} {{item.state === 'answer' && fb === 'ok' ? 'fb-ok' : ''}}"
          style="animation-delay:{{item.delay}}s"
          data-id="{{item.id}}"
          bindtap="onOption">
          <text class="option-text">{{item.text}}</text>
          <text wx:if="{{item.state === 'answer'}}" class="option-check">✓</text>
        </button>
      </view>

      <view wx:if="{{showExplain}}" class="explain">{{explain}}</view>
      <view wx:if="{{showExplain}}" class="explain-timer">
        <view class="explain-timer-bar {{explainLong ? 'explain-timer-long' : ''}}"></view>
      </view>

      <view
        wx:for="{{confettiPieces}}"
        wx:key="id"
        class="confetti confetti-quick"
        style="left:{{item.left}}%; animation-delay:{{item.delay}}s; background:{{item.color}}"></view>
    </view>
  </view>
</view>
