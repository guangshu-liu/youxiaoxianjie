{
  "name": "youxiaoxianjie",
  "version": "1.0.0",
  "private": true,
  "description": "识字闯关 — 给幼小衔接阶段孩子的离线可玩识字游戏",
  "scripts": {
    "setup": "python3 tools/tts_gen.py --sync",
    "tts": "python3 tools/tts_gen.py",
    "tts:review": "python3 tools/tts_gen.py --review",
    "tts:verify": "python3 tools/tts_gen.py --verify",
    "tts:placeholder": "python3 tools/tts_gen.py --placeholder",
    "ziku": "python3 tools/gen_ziku.py",
    "ziku:check": "python3 tools/gen_ziku.py --check",
    "validate": "python3 tools/build.py all --check-only",
    "test": "node tools/smoke_test.js",
    "test:build": "node tools/smoke_test.js --from-build",
    "verify": "npm run ziku:check && npm run validate && npm run test && npm run build && npm run test:build",
    "build": "python3 tools/build.py all",
    "build:online": "python3 tools/build.py online",
    "build:single": "python3 tools/build.py single",
    "icons": "python3 tools/make_icons.py",
    "deploy": "python3 tools/deploy_pages.py",
    "deploy:dry": "python3 tools/deploy_pages.py --dry-run",
    "serve": "python3 -m http.server 8080 --directory output/online",
    "server": "python3 -m http.server 8080 --directory output/online",
    "serve:docs": "python3 -m http.server 8080 --directory docs"
  },
  "comment": "本项目零 npm 依赖。package.json 只是命令包装，方便记忆。所有工具都是纯 Python 3 / Node 标准库。",
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {}
}
